{
  "name": "@salesforce-agent/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && sh -c 'P=\"${VITE_DEV_PORT:-5173}\"; pnpm exec wait-on \"tcp:127.0.0.1:$P\" && exec env VITE_DEV_SERVER_URL=\"http://127.0.0.1:$P\" pnpm exec electron .'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@salesforce-agent/agent-service": "workspace:*",
    "@salesforce-agent/persistence-sqlite": "workspace:*",
    "@salesforce-agent/salesforce-core": "workspace:*",
    "@salesforce-agent/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^34.0.0",
    "typescript": "latest",
    "wait-on": "^8.0.1"
  }
}

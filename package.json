{
  "name": "salesforce-t3-code",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  },
  "scripts": {
    "dev": "turbo run dev --filter=@salesforce-agent/renderer --filter=@salesforce-agent/desktop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "clean": "rm -rf .turbo node_modules apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "latest"
  }
}
